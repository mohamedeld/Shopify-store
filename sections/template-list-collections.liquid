<div class="flex flex-col items-center my-8">
  <h1 class="text-3xl font-medium">{{ section.settings.title }}</h1>
  <div class="max-w-6xl mx-auto py-3">
    <div class="grid grid-col-1 md:grid-cols-3 gap-3">
      {% for collection in collections %}
        {% if collection.all_products_count > 0 %}
          <div class="w-full py-6 px-3">
            <div class="border border-gray-200 overflow-hidden">
              <a href="{{collection.url}}">
                <div class="h-80 overflow-hidden">
                  {% if collection.featured_image != blank %}
                    <img
                      src="{{collection.featured_image | img_url: 'medium'}}"
                      alt="{{collection.title | escape}}"
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-300' }}
                  {% endif %}
                  <img
                    src="{{collection.image | img_url:'medium'}}"
                    alt="{{collection.title | escape}}"
                    class="w-full h-full object-cover" />
                </div>
              </a>
              <div class="p-4 bg-gray-100">
                <h1 class="text-xl ">{{ collection.title }}</h1>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Template List Collection",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "default": "Collections",
        "label": "Title"
      }
    ]
  }
{% endschema %}