<div class="flex flex-col items-center my-8">
  {% if section.settings.title != blank %}
    <h1 class="text-3xl font-medium my-8 md:my-16">{{ section.settings.title }}</h1>
  {% endif %}
  {% form 'contact' %}
    <div class="max-w-6xl mx-auto flex-1 justify-center items-center px-4">
      {% if form.errors %}
        <div class="bg-red-100 text-red-700 p-4 rounded mb-4">
          <ul class="px-4 mb-3 ml-7 list-decimal">
            {% for error in form.errors %}
              <li>
                <span>{{ form.errors.messages[error] }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      {% if form.posted_successfully? %}
        <div class="bg-green-100 text-green-700 p-4 rounded mb-4">
          Comment submitted successfully.
        </div>
      {% endif %}
      <div class="flex px-1 mb-3">
        <div class="px-3 md:w-1/2">
          <label for="contact_name" class="uppercase text-xs text-gray-500 font-medium">Name</label>
          <input
            type="text"
            name="contact[name]"
            id="contact_name"
            class="border border-gray-200 py-3 px-4 text-gray-700 w-full rounded-md focus:outline-none focus:ring-2 focus:ring-gray-600 focus:border-transparent">
        </div>
        <div class="px-3 md:w-1/2">
          <label for="contact_email" class="uppercase text-xs text-gray-500 font-medium">Email</label>
          <input
            type="email"
            name="contact[email]"
            id="contact_email"
            class="border border-gray-200 py-3 px-4 text-gray-700 w-full rounded-md focus:outline-none focus:ring-2 focus:ring-gray-600 focus:border-transparent" />
        </div>
      </div>


      <div class="flex px-1 mb-3">
        <div class="w-full px-3">
          <label for="contact_body" class="uppercase text-xs text-gray-500 font-medium">Message</label>
          <textarea
            name="contact[body]"
            id="contact_body"
            class="border border-gray-200 py-3 px-4 text-gray-700 w-full rounded-md focus:outline-none focus:ring-2 focus:ring-gray-600 focus:border-transparent"></textarea>
        </div>
      </div>

      <div class="flex px-1 mb-3">
        <div class="w-full px-3">
          <input
            type="submit"
            value="Submit message"
            class="bg-gray-800 text-white py-3 px-6 rounded-md hover:bg-gray-700 transition-colors duration-300" />
        </div>
      </div>
    </div>
  {% endform %}
</div>


{% schema %}
  {
    "name": "Contact Form",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      }
    ],
    "presets": [
      {
        "name": "Contact Form"
      }
    ]
  }
{% endschema %}