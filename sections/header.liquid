{% assign main_menu_linklist = linklists[section.settings.menu].links %}

  <div class="relative bg-white" x-data="{ mobileMenuOpen: false, searchOpen:false }">
  <div class="mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center py-6 md:justify-start md:space-x-10">
      <div class="flex justify-start lg:flex-1 truncate">
        <h1 class="text-xl font-bold truncate">{{ section.settings.mobile_menu_title }}</h1>
      </div>

      <nav class="hidden md:flex space-x-10">
        {% for link in main_menu_linklist %}
          {% if link.links != blank %}
            <div class="relative" x-data="{ open: false }">
              <button
                x-on:click="open = ! open"
                type="button"
                class="inline-flex items-center gap-1 text-base text-gray-500 hover:text-gray-900">
                {{ link.title }}
                {% render 'chevron-down' %}
              </button>
              <div
                x-show="open"
                @click.away="open = false"
                x-cloak
                class="absolute z-10 -ml-5 mt-5 transform px-2 w-screen max-w-md sm:px-0 lg:ml-0 lg:left-1/2 lg:-translate-x-1/2">
                <div class="shadow-lg border ring-black ring-opacity-5 overflow-hidden rounded-lg">
                  <div class="relative grid gap-6 bg-white px-5 py-6 sm:gap-8 sm:p-8">
                    {% for item in link.links %}
                      <a class="-m-3 p-3 flex items-start rounded-lg hover:bg-gray-100" href="{{ item.url }}">
                        <div class="ml-4">
                          <p class="text-gray-900 text-base font-medium">
                            {{ item.title }}
                          </p>
                        </div>
                      </a>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {% else %}
            <div class="relative">
              <a href="{{ link.url }}" class="text-base text-gray-500 hover:text-gray-900">{{ link.title }}</a>
            </div>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="hidden md:flex items-center justify-end md:flex-1 space-x-5">
        <button
          type="button"
          class="whitespace-nowrap text-base text-gray-500 hover:text-gray-900"
          x-on:click="searchOpen = true">
          {% render 'icons-search' %}
        </button>
        <a href="{{ routes.cart_url }}" class="whitespace-nowrap text-base text-gray-500 hover:text-gray-900">
          {% render 'icon-shopping-bag' %}
        </a>
        {% if shop.customer_accounts_enabled %}
          {% if customer %}
            <a class="text-base text-gray-500 hover:text-gray-900" href="{{ routes.account_url }}">Account</a>
            <a class="text-base text-gray-500 hover:text-gray-900" href="{{ routes.account_logout_url }}">Logout</a>
          {% else %}
            <a class="text-base text-gray-500 hover:text-gray-900" href="{{ routes.account_login_url }}">Login</a>
            <a class="text-base text-gray-500 hover:text-gray-900" href="{{ routes.account_register_url }}">Register</a>
          {% endif %}
        {% endif %}
      </div>

      <div class="-mr-2 -my-2 ml-3 flex md:hidden">
        <button
          x-on:click="mobileMenuOpen = ! mobileMenuOpen"
          type="button"
          class="bg-white p-2 inline-flex items-center justify-center focus:outline-none">
          {% render 'menu-icon' %}
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    x-show="mobileMenuOpen"
    x-cloak
    class="fixed inset-0 z-50 md:hidden"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0">

    <div class="fixed inset-0 bg-black bg-opacity-25" x-on:click="mobileMenuOpen = false"></div>

    <div class="relative bg-white w-full max-w-sm shadow-xl">
      <div class="p-5 divide-y-2 divide-gray-50">
        <!-- MOBILE MENU HEADER -->
        <div class="flex items-center justify-between pb-3">
          <div>
            <h1 class="text-lg font-semibold text-gray-900">{{ section.settings.mobile_menu_title }}</h1>
          </div>
          <div class="-mr-2">
            <button
              x-on:click="mobileMenuOpen = false"
              type="button"
              class="bg-white rounded-md p-2 text-gray-500 hover:text-gray-900">
              {% render 'close-icon' %}
            </button>
          </div>
        </div>

        <!-- NAVIGATION LINKS FOR MOBILE MENU -->
        <div class="pt-3">
          <nav class="grid gap-y-7">
            {% for link in main_menu_linklist %}
              {% if link.links != blank %}
                <div class="relative" x-data="{ openChildMenu: false }">
                  <button
                    type="button"
                    x-on:click="openChildMenu = ! openChildMenu"
                    class="text-base text-gray-500 hover:text-gray-900 flex items-center justify-between w-full">
                    {{ link.title }}
                    <span :class="{'rotate-180': openChildMenu}" class="transform transition-transform">
                      {% render 'chevron-down' %}
                    </span>
                  </button>
                  <div
                    class="grid gap-y-4 py-3 pl-4"
                    x-show="openChildMenu"
                    x-cloak>
                    {% for item in link.links %}
                      <a href="{{ item.url }}" class="block p-2 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50">
                        {{ item.title }}
                      </a>
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                <a href="{{ link.url }}" class="block p-2 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50">
                  {{ link.title }}
                </a>
              {% endif %}
            {% endfor %}
          </nav>
        </div>

        <!-- Mobile Menu Footer with Auth Links -->
        {% if shop.customer_accounts_enabled %}
          <div class="pt-5 mt-5">
            {% if customer %}
              <a href="{{ routes.account_url }}" class="block p-2 text-gray-500 hover:text-gray-900">My
 
 
 
 
 
 
 
 
 
                        Account</a>
              <a href="{{ routes.account_logout_url }}" class="block p-2 text-gray-500 hover:text-gray-900">Logout</a>
            {% else %}
              <a href="{{ routes.account_login_url }}" class="block p-2 text-gray-500 hover:text-gray-900">Login</a>
              <a href="{{ routes.account_register_url }}" class="block p-2 text-gray-500 hover:text-gray-900">Register</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="w-full absolute top-0 bg-white border z-10" x-show="searchOpen">
    <button class="absolute top-0 right-0 mr-5 mt-5 text-gray-500" x-on:click="searchOpen = false">
      {% render 'close-icon' %}
    </button>
    <div class="h-40 flex justify-center items-center">
      <form action="{{routes.search_url}}" method="get">
        <input
          type="text"
          name="q"
          placeholder="Search..."
          class="border rounded-md p-2 w-1/2">
        <button type="submit" class="ml-2 bg-gray-500 text-white px-4 py-2 rounded-md">Search</button>
      </form>
    </div>
  </div>
</div>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "text",
        "id": "mobile_menu_title",
        "label": "Title",
        "default": "Mohamed Store",
        "info": "This is for the mobile menu window"
      }, {
        "type": "link_list",
        "id": "menu",
        "label": "Header Menu",
        "default": "main-menu"
      }
    ]
  }
{% endschema %}