{% assign first_product = collection.products.first %}

{% if first_product %}
  {% assign first_variant = first_product.selected_or_first_available_variant %}
  {% if first_variant %}
    <form method="post" action="{{ routes.cart_add_url }}">
      <input type="hidden" name="id" value="{{ first_variant.id }}">
      <button type="submit">{{ 'sections.collection.add_first_product_to_cart' | t }}</button>
    </form>
  {% endif %}
{% endif %}

{% paginate collection.products by 6 %}
  {% for product in collection.products %}
    <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
    {% else %}
        <p>There are no products inside of this collection</p>
  {% endfor %}

  {% render 'pagination', pagination:paginate %}
{% endpaginate %}