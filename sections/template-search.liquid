<div class="container mx-auto">
    {% paginate search.results 10 %}
        <h1 class="text-xl my-4 text-center">Search Results</h1>
        <div class="flex justify-center items-center">
            <form action="{{routes.search_url}}" method="get">
                <input
                    type="text"
                    name="q"
                    value="{{search.terms}}"
                    placeholder="Search..."
                    class="border rounded-md p-2 w-1/2">
                <button type="submit" class="ml-2 bg-gray-500 text-white px-4 py-2 rounded-md">Search</button>
            </form>
        </div>
        {% if search.performed %}
            {% if search.results.size > 0 %}
                <p class="text-gray-500 text-center my-10">{{search.results.size}} results for the search term "{{search.terms}}"</p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    {% for item in search.results %}
            {% case item.object_type %}
                {% when 'product' %}
                    {% render 'product-card', product:item %}
                {% else %}
                    
            {% endcase %}
        {% endfor %}
                </div>
                {% else %}
                    <div class="text-center my-4">
                        <p>No results found for "{{search.terms}}"</p>
                    </div>
            {% endif %}
        {% endif %}
        
    
        {% render 'pagination',pagination:paginate %}
    {% endpaginate %}

</div>
